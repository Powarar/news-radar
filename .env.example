# App
APP_NAME=news-radar
APP_ENV=development
SECRET_KEY=change-me-to-random-string
DEBUG=true
TRUST_PROXY_HEADERS=false

#TTL
OAUTH_CODE_TTL=300

# PostgreSQL
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=newsradar
POSTGRES_USER=newsradar
POSTGRES_PASSWORD=newsradar

# Redis
REDIS_URL=redis://redis:6379/0

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Telegram Bot
TELEGRAM_BOT_TOKEN=

# Telegram Parser (Telethon)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=newsradar

# HuggingFace (deprecated, kept for compatibility)
HUGGINGFACE_API_TOKEN=
HF_CLASSIFIER_MODEL_URL=
HF_SUMMARIZER_MODEL_URL=

# Groq (summarization + classification)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Frontend
VITE_API_URL=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=
VITE_TG_BOT_USERNAME=

#Api
BACKEND_URL=http://backend:8000
QDRANT_HOST=qdrant
EMBEDDING_SERVICE_URL=http://embedding-service:8001
EMBEDDING_SERVICE_TIMEOUT=60
EMBEDDING_DIMENSION=384
QDRANT_COLLECTION_NAME=news_feed_minilm_384
FRONTEND_URL=http://localhost:5173
